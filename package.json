{
  "name": "@indoulia/ferret",
  "version": "0.1.0",
  "description": "Persistent engineering context and knowledge layer for AI-assisted development.",
  "keywords": [
    "mcp",
    "ai",
    "context",
    "knowledge",
    "developer-tools"
  ],
  "homepage": "https://github.com/indoulia/Ferret#readme",
  "bugs": {
    "url": "https://github.com/indoulia/Ferret/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indoulia/Ferret.git"
  },
  "license": "MIT",
  "author": "Indoulia",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ferret": "dist/cli/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "default": "./dist/git/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "default": "./dist/parsers/index.js"
    },
    "./testing": {
      "types": "./dist/providers/sdk/testing.d.ts",
      "default": "./dist/providers/sdk/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && node scripts/copy-grammars.mjs",
    "prepack": "npm run build",
    "clean": "node scripts/clean.mjs",
    "migration:generate": "node scripts/generate-migration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "baseline": "node scripts/baseline.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "dogfood:db": "node scripts/dogfood-db.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.13",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "testcontainers": "^12.1.0",
    "tree-sitter-wasms": "^0.1.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
