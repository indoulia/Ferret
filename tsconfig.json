{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Ferret's own published subpaths, resolved to source.
    //
    // `ferret index --content` composes the parser through EPIC-013 discovery
    // with the package's own specifier (EPIC-108 §8.5), which Node resolves by
    // self-reference at runtime. Type-checking would otherwise resolve it
    // through `exports` to `dist/`, which does not exist until `build` has
    // run — and `verify` type-checks before it builds. This maps the same
    // specifier onto the sources it is built from. It affects checking only:
    // TypeScript does not rewrite the specifier, so what ships still
    // self-references.
    "paths": {
      "@indoulia/ferret/parsers": ["./src/parsers/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
